{
  "algorithm": "dqn",
  "train": {
    "episodes": 20000,
    "seed": 0,
    "output": "artifacts/checkpoints/dqn_baseline_v2.pt",
    "players": 4,
    "dueling": true,
    "device": "auto",
    "batch_size": 256,
    "num_envs": 8,
    "replay_capacity": 10000,
    "warmup_steps": 2000,
    "train_frequency": 4,
    "gradient_steps": 1,
    "target_interval": 500,
    "n_step": 1,
    "prioritized_replay": true,
    "opponent_names": [
      "random",
      "greedy",
      "conservative",
      "counting"
    ],
    "reward": "terminal",
    "eval_interval": 500,
    "eval_games": 128,
    "eval_opponent": "counting",
    "checkpoint_interval": 1000,
    "keep_snapshots": 5,
    "tensorboard_dir": "artifacts/tensorboard/dqn_baseline_v2",
    "gamma": 1.0
  }
}
